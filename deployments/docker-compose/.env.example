# Copy to .env and replace every value. Never commit .env.
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# openssl rand -base64 48
SESSION_SECRET=
CSRF_SECRET=
MFA_ENCRYPTION_KEY=

# Public portal
PUBLIC_BASE_URL=https://user.example.com
COOKIE_SECURE=true
COOKIE_DOMAIN=user.example.com

# Internal gRPC callers use database-managed integration client credentials.

# Required when enabling webhook subscriptions (generate a separate 32+ byte secret).
# Outbox webhook signing (HMAC-SHA256 of the raw body)
OUTBOX_SIGNING_SECRET=

# Optional OAuth providers. Leave empty to hide the buttons.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# OIDC provider (V2). Required stable RSA private key (2048+ bits), outside this
# repository. Compose mounts it read-only at /run/secrets/oidc_signing_key.
OIDC_ISSUER=
OIDC_SIGNING_KEY_FILE=
OIDC_ACCESS_TTL_SECONDS=900
OIDC_REFRESH_TTL_SECONDS=86400
